# TekaLang v0.3 — Python-style source, native C++ compilation

def square(value: int) -> int:
	return value * value

username = 'teka'
score = 0

for number in range(1, 6):
	score += square(number)

if score > 50:
	print('hello', username)
	print('score:', score)
else:
	print('keep going!')

values = [2, 4, 6]
for value in values:
	print('value:', value)